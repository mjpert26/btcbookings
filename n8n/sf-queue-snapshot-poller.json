      "parameters": {
        "jsCode": "// Builds the GroupMember query for every linked queue.\nconst queueIds = $('Get Linked Queues').first().json.queueIds || [];\nfor (const id of queueIds) {\n  if (!/^00G[A-Za-z0-9]{15}$/.test(id)) throw new Error('Unexpected queue id from BTC Scheduler: ' + id);\n}\nconst inList = queueIds.map((id) => \"'\" + id + \"'\").join(',');\nreturn [{ json: {\n  queueIds,\n  soql: 'SELECT GroupId, UserOrGroupId FROM GroupMember WHERE GroupId IN (' + inList + ')',\n} }];\n"
      },
