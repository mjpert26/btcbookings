# BTC Scheduler environment variables.
# Copy to .env.local for local development. In Vercel, set these per environment
# (Production, Preview, Development). Never commit real values.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL of this deployment, no trailing slash. Used for OAuth redirects,
# Graph notification URLs, and links in emails.
APP_BASE_URL=http://localhost:3000

# Postgres connection string. In Supabase use the transaction pooler (port 6543):
# Project > Connect > Transaction pooler. Local dev: scripts/local-db.sh prints one.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/btc_scheduler
# Max connections per serverless instance. Keep small with the transaction pooler.
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Microsoft Entra ID (see docs/entra-setup.md)
# ---------------------------------------------------------------------------
# BTC tenant (Directory) ID.
ENTRA_TENANT_ID=91e22286-3995-43b2-9197-481a21962994
# Application (client) ID of the "BTC Scheduler" app registration.
ENTRA_CLIENT_ID=
# Client secret value (not the secret ID). Rotate before it expires.
ENTRA_CLIENT_SECRET=
# Comma-separated email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=bigthinkcapital.com
# Comma-separated emails promoted to global admin on sign-in (in addition to app.admin_seeds).
ADMIN_EMAILS=mike.perticone@bigthinkcapital.com,brian.weiss@bigthinkcapital.com

# ---------------------------------------------------------------------------
# Secrets at rest
# ---------------------------------------------------------------------------
# AES-256-GCM keys as "kid:base64key" pairs, comma-separated. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add a new kid, set TOKEN_ENCRYPTION_ACTIVE_KID to it, keep the old key
# until all rows have been re-encrypted (users re-sign in or tokens refresh).
TOKEN_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
TOKEN_ENCRYPTION_ACTIVE_KID=k1
# Salt for hashing client IPs (rate limiting, sessions). At least 16 characters.
IP_HASH_SALT=REPLACE_WITH_RANDOM_STRING

# ---------------------------------------------------------------------------
# Vercel Cron
# ---------------------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes. At least 16 characters.
CRON_SECRET=REPLACE_WITH_RANDOM_STRING

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile). Leave empty locally to skip verification.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email (Resend). Leave RESEND_API_KEY empty to log emails instead of sending.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="BTC Scheduling <scheduling@bigthinkcapital.com>"

# ---------------------------------------------------------------------------
# Slack (see docs/slack-setup.md). Leave empty to disable Slack sync.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
# Optional fallback channel ID for "added/removed" notices.
SLACK_ADMIN_NOTIFY_CHANNEL=

# ---------------------------------------------------------------------------
# n8n and Salesforce (see docs/n8n-workflows.md and docs/salesforce-changes.md)
# ---------------------------------------------------------------------------
N8N_BASE_URL=https://api.bigthinkcapital.com
N8N_LEAD_WEBHOOK_PATH=/webhook/btc-scheduler/lead
# HMAC secret for requests this app sends to n8n (lead create, "sync now").
# Must equal BTC_SCHEDULER_SIGNING_SECRET in the n8n environment.
N8N_SIGNING_SECRET=
# HMAC secret n8n and Apex use to sign queue snapshots and pushes to this app.
SF_SYNC_SIGNING_SECRET=
# Bearer token for the optional Salesforce Flow HTTP Callout push (External Credential header).
SF_QUEUE_PUSH_BEARER=
# Maximum attempts for a Salesforce lead job before it is marked failed.
SF_LEAD_MAX_ATTEMPTS=8
# Teams whose last queue snapshot is older than this are flagged as stale.
QUEUE_POLL_STALE_MINUTES=10
