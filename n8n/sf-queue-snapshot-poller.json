    {
      "parameters": {
        "jsCode": "// Splits queue members into users (005...) and nested groups (00G...).\n// Note: GroupMember has no User relationship, so User.Email cannot be selected here;\n// user details come from the \"Query Users\" node.\nconst queueIds = $('Build Queue Member Query').first().json.queueIds;\nconst records = $input.all().flatMap((page) => page.json.records || []);\nconst direct = [];\nconst nestedParents = {};\nfor (const r of records) {\n  const id = String(r.UserOrGroupId || '');\n  if (id.startsWith('005')) {\n    direct.push({ queueId: r.GroupId, userId: id });\n  } else if (id.startsWith('00G')) {\n    (nestedParents[id] = nestedParents[id] || []).push(r.GroupId);\n  }\n}\nconst nestedGroupIds = Object.keys(nestedParents);\nconst quote = (ids) => ids.map((id) => \"'\" + id + \"'\").join(',');\nconst allGroups = queueIds.concat(nestedGroupIds);\nreturn [{ json: {\n  queueIds,\n  direct,\n  nestedParents,\n  nestedGroupIds,\n  nestedSoql: nestedGroupIds.length\n    ? 'SELECT GroupId, UserOrGroupId FROM GroupMember WHERE GroupId IN (' + quote(nestedGroupIds) + ')'\n    : '',\n  userSoql: 'SELECT Id, Email, IsActive FROM User WHERE Id IN (SELECT UserOrGroupId FROM GroupMember WHERE GroupId IN (' + quote(allGroups) + '))',\n} }];\n"
      },
