      "parameters": {
        "jsCode": "// Signs the GET /api/sync/linked-queues request (HMAC over an empty body).\nconst crypto = require('crypto');\nconst secret = $env.BTC_SCHEDULER_SIGNING_SECRET;\nif (!secret) throw new Error('BTC_SCHEDULER_SIGNING_SECRET is not set');\nif (!$env.BTC_SCHEDULER_BASE_URL) throw new Error('BTC_SCHEDULER_BASE_URL is not set');\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.', 'utf8').digest('hex');\nreturn [{ json: { timestamp, signature } }];\n"
      },
