    {
      "parameters": {
        "jsCode": "// Verifies the HMAC signature on a \"sync now\" request from BTC Scheduler.\n// Headers: X-BTC-Timestamp (unix seconds), X-BTC-Signature: sha256=<hex HMAC of \"<timestamp>.<raw body>\">.\n// Secret: $env.BTC_SCHEDULER_N8N_SIGNING_SECRET (equals N8N_SIGNING_SECRET in the app).\nconst crypto = require('crypto');\nconst secret = $env.BTC_SCHEDULER_N8N_SIGNING_SECRET;\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst ts = String(headers['x-btc-timestamp'] || '');\nconst sig = String(headers['x-btc-signature'] || '');\n\nlet valid = false;\nlet reason = 'missing';\nif (!secret) {\n  reason = 'not_configured';\n} else if (ts && sig && item.binary && item.binary.data) {\n  const raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n  const now = Math.floor(Date.now() / 1000);\n  if (!/^\\d{9,11}$/.test(ts) || Math.abs(now - Number(ts)) > 300) {\n    reason = 'stale';\n  } else {\n    const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + raw, 'utf8').digest('hex');\n    const a = Buffer.from(expected, 'utf8');\n    const b = Buffer.from(sig, 'utf8');\n    valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n    reason = valid ? 'ok' : 'bad_signature';\n  }\n}\nreturn [{ json: { valid, reason } }];\n"
      },
      "id": "0df48605-bd45-5797-89b9-4c6e06e9d59d",
      "name": "Verify Sync Now Signature",
