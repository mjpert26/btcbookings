    {
      "parameters": {
        "jsCode": "// Builds and signs the snapshot. Every linked queue is included, with an empty member list\n// when it has no members, so the app can apply its empty-queue safety rail.\nconst crypto = require('crypto');\nconst secret = $env.BTC_SCHEDULER_SIGNING_SECRET;\nif (!secret) throw new Error('BTC_SCHEDULER_SIGNING_SECRET is not set');\n\nconst collected = $('Collect Members').first().json;\nconst users = {};\nfor (const page of $('Query Users').all()) {\n  for (const r of page.json.records || []) users[r.Id] = r;\n}\n\n// One level of nested public groups is expanded. Deeper groups, roles and territories are skipped.\nlet nestedRecords = [];\nif (collected.nestedGroupIds.length > 0) {\n  nestedRecords = $('Query Nested Group Members').all().flatMap((page) => page.json.records || []);\n}\n\nconst byQueue = {};\nfor (const q of collected.queueIds) byQueue[q] = {};\nconst add = (queueId, userId) => {\n  const u = users[userId];\n  if (!u || !u.Email || !byQueue[queueId]) return;\n  byQueue[queueId][userId] = { sfUserId: userId, email: u.Email, isActive: u.IsActive === true };\n};\nfor (const d of collected.direct) add(d.queueId, d.userId);\nlet skippedNested = 0;\nfor (const r of nestedRecords) {\n  const id = String(r.UserOrGroupId || '');\n  if (!id.startsWith('005')) { skippedNested++; continue; }\n  for (const queueId of collected.nestedParents[r.GroupId] || []) add(queueId, id);\n}\n\nconst snapshot = {\n  snapshotId: crypto.randomUUID(),\n  takenAt: new Date().toISOString(),\n  queues: collected.queueIds.map((queueId) => ({ queueId, members: Object.values(byQueue[queueId]) })),\n};\nconst rawBody = JSON.stringify(snapshot);\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + rawBody, 'utf8').digest('hex');\nreturn [{ json: {\n  rawBody,\n  timestamp,\n  signature,\n  nonce: snapshot.snapshotId,\n  queueCount: snapshot.queues.length,\n  memberCount: snapshot.queues.reduce((n, q) => n + q.members.length, 0),\n  skippedNested,\n} }];\n"
      },
